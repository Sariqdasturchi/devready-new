{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://devreadyapi-production.up.railway.app/api/seo/sitemap.xml" },
    { "source": "/uploads/images/:path*", "destination": "https://devreadyapi-production.up.railway.app/uploads/images/:path*" },
    {
      "source": "/blogs/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(telegrambot|facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|vkshare|skypeuripreview|pinterest|redditbot|applebot|yandex).*"
        }
      ],
      "destination": "https://devreadyapi-production.up.railway.app/api/seo/blogs/:slug"
    },
    { "source": "/((?!assets/|.*\\.[a-z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
